<Window x:Class="SkylineCadenza.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SkylineCadenza.App.ViewModels"
        xmlns:sched="clr-namespace:SkylineCadenza.Core.Scheduling;assembly=SkylineCadenza.Core"
        xmlns:scott="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Skyline Cadenza" Width="1340" Height="880"
        Icon="pack://application:,,,/assets/cadenza.ico">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <vm:EnumEqualsConverter x:Key="EnumEq"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Parameter panel -->
        <ScrollViewer Grid.Column="0" Margin="8" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Logo header -->
                <Image Source="pack://application:,,,/assets/logo.jpg" Stretch="Uniform"
                       MaxHeight="120" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <!-- Inputs -->
                <TextBlock Text="Inputs" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="DIA-NN report.parquet"/>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="..." Width="32" Command="{Binding BrowseReportCommand}" Margin="4,0,0,0"/>
                    <TextBox Text="{Binding ReportPath, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <TextBlock Text="Carafe library TSV (optional)" Margin="0,8,0,0"/>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="..." Width="32" Command="{Binding BrowseCarafeCommand}" Margin="4,0,0,0"/>
                    <TextBox Text="{Binding CarafeTsvPath, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <CheckBox Content="Backfill unused schedule time with Carafe predictions"
                          IsChecked="{Binding BackfillWithPredictions}" Margin="0,6,0,0"
                          ToolTip="Needs both a DIA-NN report and a Carafe library. Schedules the confirmed DIA-NN targets first, then fills leftover schedule capacity with Carafe-predicted targets (deduped against confirmed ones on peptide + charge), scoped to the proteins DIA-NN saw plus any target-protein list. Off: the Carafe library only overrides DIA-NN fragments and adds no precursors. Takes effect on the next Load."/>
                <TextBlock Text="Bromo peptide ranking (optional)" Margin="0,8,0,0"
                           ToolTip="Carafe-only mode. A single Bromo peptide_rankings.tsv. Sets within-protein peptide priority; auto-selects the Predicted ranking option at load."/>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="..." Width="32" Command="{Binding BrowsePredictedRankingCommand}" Margin="4,0,0,0"/>
                    <TextBox Text="{Binding PredictedRankingPath, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <TextBlock Text="Carafe detectability predictions (optional)" Margin="0,8,0,0"
                           ToolTip="One or more Carafe *_detectability_pred.tsv files (multi-select), or a folder - one path per line. Used for the detectability cutoff below. If no Bromo peptide ranking is supplied, predicted detectabilities will determine the within-protein peptide priority."/>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="..." Width="32" VerticalAlignment="Top" Command="{Binding BrowseDetectabilityCommand}" Margin="4,0,0,0"/>
                    <TextBox Text="{Binding DetectabilityPath, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto" MaxHeight="64"
                             ToolTip="One file or folder per line. Multi-select in the file dialog to add several detectability shards."/>
                </DockPanel>
                <TextBlock Text="{Binding DetectabilityCutoff, StringFormat='Detectability cutoff: {0:0.00}'}" Margin="0,8,0,0"
                           ToolTip="Drops candidates whose Carafe detectability is below this. Needs a detectability predictions file above; precursors with no prediction are kept."/>
                <Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding DetectabilityCutoff}"/>
                <TextBlock Text="{Binding PeakHalfWidthSec, StringFormat='Predicted peak half-width (Carafe): {0:0} s'}" Margin="0,8,0,0"
                           ToolTip="Half-width of the synthesised peak on the Carafe path (apex +/- this), since the predicted library carries only an apex. The RT buffer below is added on top. Ignored for the DIA-NN workflow."/>
                <Slider Minimum="2" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PeakHalfWidthSec}"/>
                <Button Content="Load + schedule" Command="{Binding LoadCommand}" Margin="0,8,0,4"/>
                <DockPanel LastChildFill="True" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Cancel" Width="64"
                            Command="{Binding CancelSkylineLoadCommand}"
                            IsEnabled="{Binding SkylineLoadCancellable}"
                            Margin="4,0,0,0"/>
                    <Button Content="Load from Skyline document" Command="{Binding LoadFromSkylineCommand}"
                            IsEnabled="{Binding SkylineConnected}"/>
                </DockPanel>
                <TextBlock Text="RT column override (optional)" FontSize="11" Opacity="0.7" Margin="0,2,0,0"/>
                <TextBox Text="{Binding SkylineRtColumnOverride, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Leave blank to auto-probe. Otherwise paste the invariant column name from Skyline's Document Grid (e.g. PredictedRetentionTime, LibraryRetentionTime, AverageMeasuredRetentionTime)."/>
                <ProgressBar IsIndeterminate="True" Height="6" Margin="0,0,0,4">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
                <TextBlock Text="{Binding SkylineStatus}" FontSize="11" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <!-- Target protein list -->
                <TextBlock Text="Target protein list" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBlock Text="Paste a FASTA, accessions (one per line), or gene symbols. Or:" TextWrapping="Wrap" FontSize="11" Opacity="0.7"/>
                <Button Content="Open FASTA / list..." Command="{Binding BrowseTargetListCommand}" HorizontalAlignment="Left" Margin="0,2,0,4"/>
                <TextBox Text="{Binding TargetProteinsText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Height="80" FontFamily="Consolas" FontSize="11"/>
                <TextBlock Text="{Binding TargetProteinsParsedCount, StringFormat='Parsed: {0} accessions resolved'}" FontSize="11" Opacity="0.7" Margin="0,2,0,4"/>
                <RadioButton Content="Target list first, fill with rest" GroupName="targetMode"
                             IsChecked="{Binding TargetMode, Converter={StaticResource EnumEq}, ConverterParameter={x:Static sched:TargetListMode.FirstThenFill}}"/>
                <RadioButton Content="Exclusive (target list only)" GroupName="targetMode"
                             IsChecked="{Binding TargetMode, Converter={StaticResource EnumEq}, ConverterParameter={x:Static sched:TargetListMode.Exclusive}}"/>

                <!-- Forced peptides -->
                <TextBlock Text="Forced peptides" FontWeight="Bold" Margin="0,12,0,4"/>
                <TextBlock Text="Scheduled before everything else, one per line (PEPTIDEK, PEPTIDEK+2, or a charge column). Or:" TextWrapping="Wrap" FontSize="11" Opacity="0.7"/>
                <Button Content="Open peptide list..." Command="{Binding BrowseForcedPeptidesCommand}" HorizontalAlignment="Left" Margin="0,2,0,4"/>
                <TextBox Text="{Binding ForcedPeptidesText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Height="60" FontFamily="Consolas" FontSize="11"
                         ToolTip="Each forced peptide is placed before the normal fill, ignoring ranking, the rank cap, the per-protein max/min and an exclusive target list. It still has to pass every quality rule (ion-share floor, fragment interference, window geometry, cycle budget) and is placed the normal way: join a compatible window, else open one, else shrink-and-place. A peptide without a charge tries its best charge state first, then the others. The rest of the schedule then fills in around them under the same rules; it may share their windows but can never drop a forced peptide."/>
                <TextBlock Text="{Binding ForcedPeptidesSummary}" TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,2,0,4"/>

                <!-- Acquisition mode -->
                <TextBlock Text="Acquisition mode" FontWeight="Bold" Margin="0,16,0,4"/>
                <RadioButton Content="MTM (multiplex)" GroupName="mode"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumEq}, ConverterParameter={x:Static sched:AcquisitionMode.Mtm}}"/>
                <RadioButton Content="PRM (1 precursor / slot)" GroupName="mode"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumEq}, ConverterParameter={x:Static sched:AcquisitionMode.Prm}}"/>
                <!-- Coverage objective -->
                <TextBlock Text="Coverage objective" FontWeight="Bold" Margin="0,16,0,4"/>
                <RadioButton Content="Balanced" GroupName="objective" Margin="0,2,0,0"
                             IsChecked="{Binding Objective, Converter={StaticResource EnumEq}, ConverterParameter={x:Static sched:CoverageObjective.Balanced}}"
                             ToolTip="Published Stellar-webinar algorithm. Reactive cover pass: walk each protein's score-sorted queue and take the first peptide that fits; on an RT-budget hit, fall back to the next peptide (slide 9). Round-robin load-up to Max peptides per protein."/>
                <RadioButton Content="Maximize Protein Coverage" GroupName="objective" Margin="0,2,0,0"
                             IsChecked="{Binding Objective, Converter={StaticResource EnumEq}, ConverterParameter={x:Static sched:CoverageObjective.MaximizeProteins}}"
                             ToolTip="Default. Look-ahead cover prefers peptides that join an existing slot for free over peptides that would open a new slot. Load-up capped at Min peptides per protein so saved budget feeds first-peptide coverage of more proteins. Falls back to opening a slot when no joinable peptide exists."/>
                <RadioButton Content="Maximize Peptide Coverage" GroupName="objective" Margin="0,2,0,0"
                             IsChecked="{Binding Objective, Converter={StaticResource EnumEq}, ConverterParameter={x:Static sched:CoverageObjective.MaximizePeptides}}"
                             ToolTip="Look-ahead cover (no joinable-first preference). Load-up uncapped: round-robin continues past Max until the cycle budget saturates or every group has exhausted its candidate queue. Fairness is preserved (a protein never gets its k+1th peptide before every other protein has had a chance at its kth)."/>

                <!-- MTM constraints -->
                <TextBlock Text="MTM constraints" FontWeight="Bold" Margin="0,16,0,4"/>
                <TextBlock Text="{Binding IsolationWindowTh, StringFormat='Isolation window cap: {0:0.0} Th'}"/>
                <Slider Minimum="1.0" Maximum="4.0" TickFrequency="0.5" Value="{Binding IsolationWindowTh}"/>
                <TextBlock Text="{Binding FragmentTolDa, StringFormat='Fragment tolerance: {0:0.00} Da'}" Margin="0,4,0,0"/>
                <Slider Minimum="0.05" Maximum="1.0" TickFrequency="0.05" Value="{Binding FragmentTolDa}"/>
                <TextBlock Text="{Binding PrmIsolationWidthTh, StringFormat='PRM / solo-slot window width: {0:0.0} Th'}" Margin="0,4,0,0"/>
                <Slider Minimum="0.4" Maximum="2.0" TickFrequency="0.1" Value="{Binding PrmIsolationWidthTh}"/>

                <TextBlock Text="{Binding MinTargetIonShare, StringFormat='Minimum target share of window current: {0:P1} (0 = off)'}" Margin="0,4,0,0"
                           ToolTip="Refuses to place a target into a window where competing ions would take so much of the fill that it cannot be quantified. Every target in the slot is checked over its own elution, and each competitor counts only the part of its peak that actually co-elutes with that target - so a huge neighbour clipping the edge of a peak is not treated the same as one sitting on top of it. The denominator is every identified precursor in the emitted band, not just the scheduled targets: on a real HeLa MTM acquisition ~66% of the current inside the target windows came from precursors that were never targets. Raising this trades protein coverage for usable signal on the targets that remain. Counts identified precursors only, so it is a lower bound on the true competition."/>
                <Slider Minimum="0" Maximum="0.30" TickFrequency="0.01" IsSnapToTickEnabled="True" Value="{Binding MinTargetIonShare}"/>

                <TextBlock Text="{Binding MaxTargetsPerSlot, StringFormat='Max targets per slot: {0} (0 = no cap)'}" Margin="0,4,0,0"
                           ToolTip="Caps how many targeted precursors one MTM window may multiplex. Once a window is full, a target that would have joined it goes to another window, opens its own, or falls through to its protein's next peptide. Untargeted co-isolated precursors and passengers do not count against the cap."/>
                <Slider Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MaxTargetsPerSlot}"/>

                <TextBlock Text="Charge handling per slot" Margin="0,8,0,2"/>
                <RadioButton Content="Match charge per slot" GroupName="chargeHandling"
                             IsChecked="{Binding ChargeHandling, Converter={StaticResource EnumEq}, ConverterParameter={x:Static sched:ChargeHandling.SameChargePerSlot}}"/>
                <RadioButton Content="Allow mixed (use slot majority charge)" GroupName="chargeHandling"
                             IsChecked="{Binding ChargeHandling, Converter={StaticResource EnumEq}, ConverterParameter={x:Static sched:ChargeHandling.AllowMixed}}"/>

                <!-- Cycle budget -->
                <TextBlock Text="Cycle budget" FontWeight="Bold" Margin="0,16,0,4"/>
                <TextBlock Text="{Binding CycleBudget, StringFormat='Concurrent slots: {0}'}"/>
                <Slider Minimum="20" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding CycleBudget}"/>
                <TextBlock Text="{Binding FiringPadSec, StringFormat='RT buffer (each side): {0:0} s'}" Margin="0,4,0,0"/>
                <Slider Minimum="0" Maximum="60" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding FiringPadSec}"/>

                <!-- Per-protein bounds -->
                <TextBlock Text="Per-protein peptide bounds" FontWeight="Bold" Margin="0,16,0,4"/>
                <TextBlock Text="{Binding MinPeptidesPerProtein, StringFormat='Minimum peptides per protein: {0}'}"/>
                <Slider Minimum="1" Maximum="6" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MinPeptidesPerProtein}"/>
                <TextBlock Text="{Binding MaxPeptidesPerProtein, StringFormat='Maximum peptides per protein: {0}'}" Margin="0,4,0,0"/>
                <Slider Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding MaxPeptidesPerProtein}"/>

                <!-- Priority knobs -->
                <TextBlock Text="Protein ranking" FontWeight="Bold" Margin="0,16,0,4"/>
                <ComboBox SelectedItem="{Binding ProteinRanking}">
                    <sched:ProteinPriority>SummedIntensity</sched:ProteinPriority>
                    <sched:ProteinPriority>ProteinQValue</sched:ProteinPriority>
                    <sched:ProteinPriority>ProvidedListOrder</sched:ProteinPriority>
                </ComboBox>
                <TextBlock Text="Peptide ranking" FontWeight="Bold" Margin="0,12,0,4"/>
                <ComboBox SelectedItem="{Binding PeptideRanking}">
                    <sched:PeptidePriority>PrecursorQuantity</sched:PeptidePriority>
                    <sched:PeptidePriority>QValue</sched:PeptidePriority>
                    <sched:PeptidePriority>PredictedRanking</sched:PeptidePriority>
                </ComboBox>
                <TextBlock Text="{Binding PeptideRankCap, StringFormat='Rank cap: top {0} per protein (0 = no cap)'}" Margin="0,8,0,0"
                           ToolTip="Only the top N precursors of each protein - ranked by the peptide ranking above - are eligible for scheduling at all. Counts precursors, so a peptide at two charge states uses two of the N. In backfill mode the cap is applied separately to the confirmed tier (by its evidence metric) and the predicted tier (by its predicted score). Distinct from the maximum above, which caps how many eligible peptides actually get scheduled."/>
                <Slider Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PeptideRankCap}"/>

                <!-- Library filter -->
                <TextBlock Text="Library filter" FontWeight="Bold" Margin="0,16,0,4"/>
                <TextBlock Text="{Binding QValueCutoff, StringFormat='Q value cutoff: {0:0.0000}'}"/>
                <Slider Minimum="0.001" Maximum="0.05" TickFrequency="0.001" Value="{Binding QValueCutoff}"/>

                <TextBlock Text="Output" FontWeight="Bold" Margin="0,16,0,4"/>
                <TextBlock Text="{Binding NormalizedCollisionEnergy, StringFormat='Normalized CE: {0:0.0}'}"/>
                <Slider Minimum="15" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding NormalizedCollisionEnergy}"/>
                <Button Content="Export Thermo CSV..." Command="{Binding ExportThermoCsvCommand}" Margin="0,4,0,4"/>
                <CheckBox IsChecked="{Binding IncludePassengers}" Margin="0,6,0,4"
                          Content="Include passengers in Skyline push"
                          ToolTip="Passengers are precursors that already fall inside a scheduled window's isolation band and elute entirely within its firing time, so the instrument fragments them either way. Including them changes only what the Skyline document extracts, never the acquisition: the exported Thermo method is identical. They are tagged 'passenger' in the transition list so they stay distinguishable from intended targets. On a real HeLa assay this added ~9,200 precursors and ~450 protein groups for no extra cycle time."/>
                <Button Content="Push targets to Skyline" Command="{Binding UpdateSkylineCommand}"
                        IsEnabled="{Binding SkylineConnected}"/>

                <TextBlock Text="{Binding StatusMessage}" Margin="0,16,0,0" TextWrapping="Wrap" FontStyle="Italic"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Plot pane: right-side dashboard -->
        <Grid Grid.Column="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Summary strip -->
            <Border Grid.Row="0" Padding="8" BorderBrush="LightGray" BorderThickness="0,0,0,1" Background="#fafafa">
                <StackPanel>
                <TextBlock Margin="0,0,0,4" FontSize="11" Opacity="0.7">
                    <Run Text="Library: "/>
                    <Run Text="{Binding LibraryPrecursors, StringFormat={}{0:n0}, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text=" precursors, "/>
                    <Run Text="{Binding LibraryPeptides, StringFormat={}{0:n0}, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text=" peptides, "/>
                    <Run Text="{Binding LibraryProteinGroups, StringFormat={}{0:n0}, Mode=OneWay}" FontWeight="Bold"/>
                    <Run Text=" protein groups"/>
                </TextBlock>
                <UniformGrid Rows="1" Columns="7">
                    <StackPanel>
                        <TextBlock Text="Precursors" Opacity="0.6" FontSize="11"/>
                        <TextBlock Text="{Binding ScheduledPrecursors, StringFormat='{}{0:n0}'}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Peptides" Opacity="0.6" FontSize="11"/>
                        <TextBlock Text="{Binding ScheduledPeptides, StringFormat='{}{0:n0}'}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Protein groups" Opacity="0.6" FontSize="11"/>
                        <TextBlock Text="{Binding ProteinsCovered, StringFormat='{}{0:n0}'}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding SlotsLabel}" Opacity="0.6" FontSize="11"/>
                        <TextBlock Text="{Binding SlotsTotal, StringFormat='{}{0:n0}'}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Slots multiplexed" Opacity="0.6" FontSize="11"/>
                        <TextBlock Text="{Binding SlotsShared, StringFormat='{}{0:n0}'}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Peak load" Opacity="0.6" FontSize="11"/>
                        <TextBlock Text="{Binding PeakLoad}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Median peptides/protein" Opacity="0.6" FontSize="11"/>
                        <TextBlock Text="{Binding MedianPeptidesPerProtein, StringFormat='{}{0:0.0}'}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Plot tabs -->
            <TabControl Grid.Row="1">
                <TabItem Header="Cycle load">
                    <scott:WpfPlot x:Name="LoadCurvePlot"/>
                </TabItem>
                <TabItem Header="Protein coverage">
                    <scott:WpfPlot x:Name="CoveragePlot"/>
                </TabItem>
                <TabItem Header="Per-run coverage">
                    <scott:WpfPlot x:Name="PerRunPlot"/>
                </TabItem>
                <TabItem Header="m/z x RT heatmap">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4">
                            <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <RadioButton Content="Full library density" GroupName="heatmapView" Margin="0,0,12,0"
                                         IsChecked="{Binding HeatmapView, Converter={StaticResource EnumEq}, ConverterParameter={x:Static vm:HeatmapView.FullLibrary}}"/>
                            <RadioButton Content="Scheduled isolation windows" GroupName="heatmapView"
                                         IsChecked="{Binding HeatmapView, Converter={StaticResource EnumEq}, ConverterParameter={x:Static vm:HeatmapView.ScheduledAssay}}"/>
                        </StackPanel>
                        <scott:WpfPlot x:Name="HeatmapPlot"/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Slot occupancy">
                    <scott:WpfPlot x:Name="OccupancyPlot"/>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
